local function getPlayerTeam(player)
    if player.Team and player.Team.Name and player.Team.Name ~= "" then return player.Team.Name end
    if player.TeamColor then return player.TeamColor.Name end
    local char = player.Character
    if char then
        local t = char:GetAttribute("Team") or char:GetAttribute("TeamName") or char:GetAttribute("team")
        if t then return tostring(t) end
    end
    local t = player:GetAttribute("Team") or player:GetAttribute("TeamName") or player:GetAttribute("team")
    if t then return tostring(t) end
    return nil
end
local function getMyTeam() return getPlayerTeam(LocalPlayer) end
local function isEnemyPlayer(player)
    if player == LocalPlayer then return false end
    local my = getMyTeam() local their = getPlayerTeam(player)
    if not my or not their then return false end
    return my ~= their
end

local function refreshVehicleCache()
    local nc = {}
    local spawned = Workspace:FindFirstChild("SpawnedVehicles")
    if not spawned then state.vehicleCache = nc return end
    local myTeam = getMyTeam()
    for _, v in ipairs(spawned:GetChildren()) do
        if v:IsA("Model") then
            local pp = v.PrimaryPart
            if not pp then pp = v:FindFirstChildWhichIsA("BasePart", true) end
            if pp then
                local ok, cf, sz = pcall(function() return v:GetBoundingBox() end)
                local hx, hy, hz
                if ok then hx, hy, hz = sz.X/2, sz.Y/2, sz.Z/2
                else hx, hy, hz = pp.Size.X/2, pp.Size.Y/2, pp.Size.Z/2 end
                local driver = nil
                for _, seat in ipairs(v:GetDescendants()) do
                    if seat:IsA("VehicleSeat") and seat.Occupant then
                        local plr = Players:GetPlayerFromCharacter(seat.Occupant.Parent)
                        if plr then driver = plr break end
                    end
                end
                local team = driver and getPlayerTeam(driver) or nil
                local isEnemy = false
                if myTeam and team then isEnemy = (team ~= myTeam) end
                nc[v] = { pp=pp, hx=hx, hy=hy, hz=hz, team=team, isEnemy=isEnemy, driver=driver }
            end
        end
    end
    state.vehicleCache = nc
end

