local function buildConfig()
    return {
        pTeam = { enabled=state.pTeam.enabled, showName=state.pTeam.showName, showDistance=state.pTeam.showDistance,
                  showHealth=state.pTeam.showHealth, showBox=state.pTeam.showBox, showOutline=state.pTeam.showOutline,
                  color=colorToTable(state.pTeam.color), maxDist=state.pTeam.maxDist },
        pEnemy = { enabled=state.pEnemy.enabled, showName=state.pEnemy.showName, showDistance=state.pEnemy.showDistance,
                   showHealth=state.pEnemy.showHealth, showBox=state.pEnemy.showBox, showOutline=state.pEnemy.showOutline,
                   color=colorToTable(state.pEnemy.color), maxDist=state.pEnemy.maxDist },
        playerTab = state.playerTab,
        vEnabled = state.vEnabled, vOnlyEnemy = state.vOnlyEnemy, vHideOwn = state.vHideOwn,
        vShowName = state.vShowName, vShowDistance = state.vShowDistance, vShowOutline = state.vShowOutline,
        vMaxDistance = state.vMaxDistance,
        vColorEnemy = colorToTable(state.vColorEnemy), vColorAlly = colorToTable(state.vColorAlly),
        trajEnabled = state.trajEnabled,
        antiHissEnabled = state.antiHissEnabled,
        droneRangeEnabled = state.droneRangeEnabled,
        menuKeyName = state.menuKey and state.menuKey.Name or "RightShift",
        configAccent = state.configAccent and colorToTable(state.configAccent) or nil,
        configBgImage = state.configBgImage,
        configBgImageEnabled = state.configBgImageEnabled,
        configBgImageTransparency = state.configBgImageTransparency,
    }
end
local function saveConfig()
    local ok, enc = pcall(function() return HttpService:JSONEncode(buildConfig()) end)
    if ok and enc then fsWrite(CONFIG_FILE, enc) end
end
local function loadConfigTable()
    local d = fsRead(CONFIG_FILE)
    if not d or d == "" then return nil end
    local ok, dec = pcall(function() return HttpService:JSONDecode(d) end)
    if ok then return dec end
    return nil
end

