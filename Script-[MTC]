unloadBtn.Font=Enum.Font.GothamMedium unloadBtn.TextSize=12 unloadBtn.Parent=main
round(unloadBtn, 5)

-- APPLY CONFIG
local function applyLoadedConfig(cfg)
    if not cfg then return end
    state.loadingConfig = true
    if cfg.pTeam then for k,v in pairs(cfg.pTeam) do
        if k == "color" then local c = colorFromTable(v) if c then state.pTeam.color = c end
        else state.pTeam[k] = v end
    end end
    if cfg.pEnemy then for k,v in pairs(cfg.pEnemy) do
        if k == "color" then local c = colorFromTable(v) if c then state.pEnemy.color = c end
        else state.pEnemy[k] = v end
    end end
    if cfg.playerTab then state.playerTab = cfg.playerTab end
    if cfg.vEnabled ~= nil then state.vEnabled = cfg.vEnabled end
    if cfg.vOnlyEnemy ~= nil then state.vOnlyEnemy = cfg.vOnlyEnemy end
    if cfg.vHideOwn ~= nil then state.vHideOwn = cfg.vHideOwn end
    if cfg.vShowName ~= nil then state.vShowName = cfg.vShowName end
    if cfg.vShowDistance ~= nil then state.vShowDistance = cfg.vShowDistance end
    if cfg.vShowOutline ~= nil then state.vShowOutline = cfg.vShowOutline end
    if cfg.vMaxDistance ~= nil then state.vMaxDistance = cfg.vMaxDistance end
    local vec = colorFromTable(cfg.vColorEnemy) if vec then state.vColorEnemy = vec end
    local vac = colorFromTable(cfg.vColorAlly) if vac then state.vColorAlly = vac end
    if cfg.trajEnabled ~= nil then state.trajEnabled = cfg.trajEnabled end
    if cfg.antiHissEnabled ~= nil then
        state.antiHissEnabled = cfg.antiHissEnabled
        if state.antiHissEnabled then enableAntiHiss() end
    end
    if cfg.droneRangeEnabled ~= nil then state.droneRangeEnabled = cfg.droneRangeEnabled end
    if cfg.menuKeyName then
        local ok, key = pcall(function() return Enum.KeyCode[cfg.menuKeyName] end)
        if ok and key then state.menuKey = key end
    end
    if cfg.configAccent then
        local c = colorFromTable(cfg.configAccent)
        if c then state.configAccent = c applyAccentColor(c) end
    end
    if cfg.configBgImage then state.configBgImage = cfg.configBgImage end
    if cfg.configBgImageEnabled ~= nil then state.configBgImageEnabled = cfg.configBgImageEnabled end
    if cfg.configBgImageTransparency ~= nil then state.configBgImageTransparency = cfg.configBgImageTransparency end
    applyBgImage()
    state.loadingConfig = false
end

-- UNLOAD
local function unload()
    if state.unloaded then return end
    state.unloaded = true
    pcall(saveConfig)
    pcall(disableAntiHiss)
    for _, c in ipairs(state.connections) do pcall(function() c:Disconnect() end) end
    state.connections = {}
    if renderConn then renderConn:Disconnect() end
    for _, d in pairs(state.teamDrawings) do destroyDrawings(d) end
    for _, d in pairs(state.enemyDrawings) do destroyDrawings(d) end
    for _, d in pairs(state.vehicleDrawings) do destroyDrawings(d) end
    for _, l in ipairs(state.trajLines) do pcall(function() l:Remove() end) end
    if state.trajImpact then pcall(function() state.trajImpact:Remove() end) end
    if state.droneRangeText then pcall(function() state.droneRangeText:Remove() end) end
    state.teamDrawings = {} state.enemyDrawings = {} state.vehicleDrawings = {}
    state.trajLines = {} state.trajImpact = nil
    state.droneRangeText = nil
    if screenGui then pcall(function() screenGui:Destroy() end) end
    _G.brieliVisUnload = nil
    print("[brieli vis] выгружен")
end
unloadBtn.MouseButton1Click:Connect(unload)
_G.brieliVisUnload = unload

bind(UserInputService.InputBegan:Connect(function(input, gp)
    if gp then return end
    if input.KeyCode == state.menuKey then main.Visible = not main.Visible end
end))

-- START
local loadedCfg = loadConfigTable()
if loadedCfg then
    task.spawn(function() task.wait(0.3) applyLoadedConfig(loadedCfg) end)
end

switchTab("visuals")
for id, b in pairs(subTabButtons) do
    b.BackgroundColor3 = (id == state.playerTab) and C.tabActive or C.row
    b.TextColor3 = (id == state.playerTab) and C.accent or C.textDim
end
for _, ch in ipairs(contentScroll:GetChildren()) do
    if ch:IsA("GuiObject") then
        local st = ch:GetAttribute("SubTab")
        if st and (st == "team" or st == "enemy") then
            ch.Visible = (st == state.playerTab)
        end
    end
end

task.spawn(function()
    while not state.unloaded do
        task.wait(5)
        if not state.unloaded and not state.loadingConfig then pcall(saveConfig) end
    end
end)

print("[brieli vis] v5 + Anti-Hiss + DroneRange загружен. Правый Shift — меню.")
