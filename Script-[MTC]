local function findDroneForLocalPlayer()
    local char = LocalPlayer.Character
    if not char then return nil end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum then return nil end

    local seat = hum.SeatPart
    if seat and seat:IsA("VehicleSeat") then
        local model = seat:FindFirstAncestorOfClass("Model")
        if model then
            local n = model.Name:lower()
            if n:find("drone") or n:find("uav") or n:find("quadcopter") or n:find("fpv") then
                return model
            end
        end
    end

    local myNameLower = LocalPlayer.Name:lower()
    local myUserId = LocalPlayer.UserId
    for _, d in ipairs(Workspace:GetChildren()) do
        if d:IsA("Model") then
            local n = d.Name:lower()
            if n:find("drone") or n:find("uav") or n:find("quadcopter") or n:find("fpv") then
                local owner = d:GetAttribute("Owner")
                    or d:GetAttribute("Controller")
                    or d:GetAttribute("Player")
                    or d:GetAttribute("Operator")
                    or d:GetAttribute("Pilot")
                if owner then
                    if owner == LocalPlayer
                       or owner == myNameLower
                       or owner == LocalPlayer.Name
                       or owner == myUserId then
                        return d
                    end
                end
            end
        end
    end

    return nil
end

local function getDroneOrigin()
    local char = LocalPlayer.Character
    if not char then return nil end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if hum and hum.SeatPart and hum.SeatPart:IsA("BasePart") then
        local seatParent = hum.SeatPart:FindFirstAncestorOfClass("Model")
