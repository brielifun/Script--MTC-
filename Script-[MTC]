-- ============== CONVEX HULL ==============
local function convexHull(pts)
    local n = #pts
    if n < 3 then return pts end
    table.sort(pts, function(a,b)
        if a.x ~= b.x then return a.x < b.x end
        return a.y < b.y
    end)
    local function cross(o,a,b)
        return (a.x - o.x)*(b.y - o.y) - (a.y - o.y)*(b.x - o.x)
    end
    local lower = {}
    for i = 1, n do
        while #lower >= 2 and cross(lower[#lower-1], lower[#lower], pts[i]) <= 0 do
            table.remove(lower)
        end
        table.insert(lower, pts[i])
    end
    local upper = {}
    for i = n, 1, -1 do
        while #upper >= 2 and cross(upper[#upper-1], upper[#upper], pts[i]) <= 0 do
            table.remove(upper)
        end
        table.insert(upper, pts[i])
    end
    table.remove(lower)
    table.remove(upper)
    local hull = {}
    for _, p in ipairs(lower) do table.insert(hull, p) end
    for _, p in ipairs(upper) do table.insert(hull, p) end
    return hull
end

-- ============== TRAJECTORY ==============
local TRAJ_STEPS = 40
local TRAJ_TIME = 3
local TRAJ_THICK = 2
local TRAJ_FALLBACK_SPEED = 250

local function ensureTrajLines()
    while #state.trajLines < TRAJ_STEPS do
        local ok, line = pcall(Drawing.new, "Line")
        if not ok or not line then break end
        line.Thickness = TRAJ_THICK
        line.Visible = false
        table.insert(state.trajLines, line)
    end
end

local function hideAllTraj()
    for _, l in ipairs(state.trajLines) do
        if l.Visible then l.Visible = false end
    end
    if state.trajImpact and state.trajImpact.Visible then state.trajImpact.Visible = false end
end

local function updateTrajectory(cam, camPos)
    if not state.trajEnabled then hideAllTraj() return end
    local char = LocalPlayer.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not char or not hum or hum.Health <= 0 then hideAllTraj() return end

    local info = nil
    local ok, r = pcall(getMuzzleInfo)
    if ok then info = r end

    local origin, dir, speed
    if info and info.pos then
        origin = info.pos
        dir = info.dir or cam.CFrame.LookVector
        speed = info.speed or TRAJ_FALLBACK_SPEED
    else
        origin = camPos + cam.CFrame.LookVector * 2
        dir = cam.CFrame.LookVector
        speed = TRAJ_FALLBACK_SPEED
    end

    local g = Workspace.Gravity
    if not g or g <= 0 then g = 196.2 end

    local dt = TRAJ_TIME / TRAJ_STEPS
    ensureTrajLines()

    local groundY = 0
    pcall(function()
        local rp = RaycastParams.new()
        rp.FilterType = Enum.RaycastFilterType.Exclude
        rp.FilterDescendantsInstances = { char }
        local hit = Workspace:Raycast(origin, Vector3.new(0, -1000, 0), rp)
        if hit then groundY = hit.Position.Y end
    end)

    local prevSp = nil
    local lastSp = nil
    local drawn = 0

    for i = 1, TRAJ_STEPS do
        local t = i * dt
        local pos = origin + dir * (speed * t) + Vector3.new(0, -0.5 * g * t * t, 0)
        local sp, onScreen = cam:WorldToViewportPoint(pos)
        if onScreen and prevSp then
            local line = state.trajLines[i]
            if line then
                line.From = Vector2.new(prevSp.X, prevSp.Y)
                line.To = Vector2.new(sp.X, sp.Y)
                line.Color = col3(state.configAccent or Color3.fromRGB(255,200,0))
                line.Thickness = TRAJ_THICK
                if not line.Visible then line.Visible = true end
                drawn = drawn + 1
            end
        end
        lastSp = sp
        prevSp = sp
        if pos.Y < groundY - 2 then break end
    end

    for i = drawn + 1, #state.trajLines do
        if state.trajLines[i].Visible then state.trajLines[i].Visible = false end
    end

    if lastSp then
        if not state.trajImpact then
            local ok2, circle = pcall(Drawing.new, "Circle")
            if ok2 and circle then
                circle.Thickness = 2
                circle.NumSides = 24
                circle.Radius = 6
                circle.Filled = true
                circle.Transparency = 0.4
                state.trajImpact = circle
            end
        end
        if state.trajImpact then
            state.trajImpact.Color = col3(state.configAccent or Color3.fromRGB(255,200,0))
            state.trajImpact.Position = Vector2.new(lastSp.X, lastSp.Y)
            if not state.trajImpact.Visible then state.trajImpact.Visible = true end
        end
    end
end

-- ============== ANTI-HISS ==============
local HISS_KEYWORDS = {
    "static","noise","hiss","drone","glitch","jam","interference","distort",
    "scanline","vhs","crt","signal","interfere","snow","grain","film","shake",
    "blur","overlay","effect","blackout","dirt","camera","cam","vision",
    "feedback","disrupt","blockage","jammer","emp","pulse",
}

local function nameMatches(name)
    local n = name:lower()
    for _, kw in ipairs(HISS_KEYWORDS) do
        if n:find(kw) then return true end
    end
    return false
end

local function hideInstance(inst, prop, val)
    if state.antiHissHidden[inst] then return end
    local old
    pcall(function() old = inst[prop] end)
    state.antiHissHidden[inst] = { prop = prop, val = val, old = old }
    pcall(function() inst[prop] = val end)
    local conn
    conn = inst:GetPropertyChangedSignal(prop):Connect(function()
        if state.unloaded then
            pcall(function() conn:Disconnect() end)
            return
        end
        if inst[prop] ~= val then
            pcall(function() inst[prop] = val end)
        end
    end)
    table.insert(state.antiHissConns, conn)
end

local function isOurGui(inst)
    if not inst then return false end
    local top = inst
    while top.Parent and top.Parent ~= parentGui do
        top = top.Parent
    end
    return top == screenGui
end

local function scanAndHideHiss()
    local pg = LocalPlayer:FindFirstChild("PlayerGui")
    if pg then
        for _, d in ipairs(pg:GetDescendants()) do
            if d:IsA("GuiObject") and nameMatches(d.Name) then
                if not isOurGui(d) then
                    hideInstance(d, "Visible", false)
                end
            elseif d:IsA("Sound") and nameMatches(d.Name) then
                hideInstance(d, "Volume", 0)
            end
        end
    end

    local cg = nil
    pcall(function() cg = game:GetService("CoreGui") end)
    if cg and cg ~= parentGui then
        for _, d in ipairs(cg:GetDescendants()) do
            if d:IsA("GuiObject") and nameMatches(d.Name) then
                if not isOurGui(d) then
                    hideInstance(d, "Visible", false)
                end
            elseif d:IsA("Sound") and nameMatches(d.Name) then
                hideInstance(d, "Volume", 0)
            end
        end
    end

    local ss = game:GetService("SoundService")
    for _, d in ipairs(ss:GetDescendants()) do
        if d:IsA("Sound") and nameMatches(d.Name) then
            hideInstance(d, "Volume", 0)
        end
    end

    local LightingSvc = game:GetService("Lighting")
    for _, d in ipairs(LightingSvc:GetChildren()) do
        if d:IsA("ColorCorrectionEffect") or d:IsA("BlurEffect")
           or d:IsA("BloomEffect") or d:IsA("SunRaysEffect") or d:IsA("DepthOfFieldEffect")
           or d:IsA("Atmosphere") or d:IsA("Sky")
           or d:IsA("ParticleEmitter") or d:IsA("Fire") or d:IsA("Smoke") or d:IsA("Sparkles") then
            if nameMatches(d.Name) then
                if d:IsA("Atmosphere") or d:IsA("Sky") then
                    hideInstance(d, "Density", 0)
                else
                    hideInstance(d, "Enabled", false)
                end
            end
        end
    end

    local cam = Workspace.CurrentCamera
    if cam then
        for _, d in ipairs(cam:GetDescendants()) do
            if d:IsA("BillboardGui") or d:IsA("SurfaceGui") then
                if nameMatches(d.Name) then
                    hideInstance(d, "Enabled", false)
                end
            elseif d:IsA("BasePart") and nameMatches(d.Name) then
                hideInstance(d, "Transparency", 1)
            elseif d:IsA("ParticleEmitter") and nameMatches(d.Name) then
                hideInstance(d, "Enabled", false)
            end
        end
    end
end

local function enableAntiHiss()
    scanAndHideHiss()
    if state.antiHissLoop then return end
    state.antiHissLoop = task.spawn(function()
        while not state.unloaded and state.antiHissEnabled do
            task.wait(0.5)
            scanAndHideHiss()
        end
        state.antiHissLoop = nil
    end)
end

local function disableAntiHiss()
    for _, c in ipairs(state.antiHissConns) do
        pcall(function() c:Disconnect() end)
    end
    state.antiHissConns = {}
    for inst, data in pairs(state.antiHissHidden) do
        if inst and inst.Parent then
            pcall(function() inst[data.prop] = data.old end)
        end
    end
    state.antiHissHidden = {}
end

