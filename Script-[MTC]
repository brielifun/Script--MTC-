local function hideDroneRange()
    if state.droneRangeText and state.droneRangeText.Visible then
        state.droneRangeText.Visible = false
    end
end

local function updateDroneRange(cam)
    if not state.droneRangeEnabled then hideDroneRange() return end

    local drone = findDroneForLocalPlayer()
    if not drone then hideDroneRange() return end
    if not drone.PrimaryPart then hideDroneRange() return end

    local origin = getDroneOrigin()
    if not origin then
        origin = drone.PrimaryPart.Position
    end

    local dronePos = drone.PrimaryPart.Position
    local distance = (dronePos - origin).Magnitude

    local maxRange = DRONE_MAX_RANGE
    local pct = math.clamp(distance / maxRange, 0, 1)

    local vpSize = cam.ViewportSize

    -- Цвет по проценту
    local col
    if pct < 0.5 then col = Color3.fromRGB(60, 220, 100)
    elseif pct < 0.8 then col = Color3.fromRGB(255, 200, 0)
    else col = Color3.fromRGB(255, 60, 60) end

    if not state.droneRangeText then
        local ok, t = pcall(Drawing.new, "Text")
        if ok and t then
            t.Size = 16
            t.Center = true
            t.Outline = true
            t.OutlineColor = Color3.new(0,0,0)
            state.droneRangeText = t
        end
    end
    if state.droneRangeText then
        state.droneRangeText.Text = string.format("Дрон: %d / %d studs (%.0f%%)",
            math.floor(distance), maxRange, pct * 100)
        state.droneRangeText.Color = col
        state.droneRangeText.Position = Vector2.new(vpSize.X/2, 60)
        if not state.droneRangeText.Visible then state.droneRangeText.Visible = true end
    end
end

-- ============== getMuzzleInfo ==============
local function findMuzzleFromTool(tool)
    if not tool then return nil end
    local handle = tool:FindFirstChild("Handle")
    for _, d in ipairs(tool:GetDescendants()) do
        if d:IsA("Attachment") then
            local n = d.Name:lower()
            if n:find("muzzle") or n:find("barrel") or n:find("fire") or n:find("shoot") or n:find("tip") or n:find("end") then
                local ok, wcf = pcall(function() return d.WorldCFrame end)
                if ok and wcf then
                    return wcf.Position, wcf.LookVector, tool
                end
            end
        end
    end
    if handle then
        local wcf = handle.CFrame * CFrame.new(0, 0, -handle.Size.Z/2)
        return wcf.Position, handle.CFrame.LookVector, tool
    end
    return nil
end

local function findMuzzleFromVehicle(vehicle)
    if not vehicle then return nil end
    for _, d in ipairs(vehicle:GetDescendants()) do
        if d:IsA("Attachment") then
            local n = d.Name:lower()
            if n:find("muzzle") or n:find("barrel") or n:find("cannon") or n:find("gunend") or n:find("fire") then
                local ok, wcf = pcall(function() return d.WorldCFrame end)
                if ok and wcf then return wcf.Position, wcf.LookVector, vehicle end
            end
        end
    end
    for _, d in ipairs(vehicle:GetDescendants()) do
        if d:IsA("BasePart") then
            local n = d.Name:lower()
            if n:find("barrel") or n:find("cannon") or n:find("muzzle") then
                local wcf = d.CFrame * CFrame.new(0, 0, -d.Size.Z/2)
                return wcf.Position, d.CFrame.LookVector, vehicle
            end
        end
    end
    return nil
end

local function readSpeedFromAttributes(obj)
    if not obj then return nil end
    local names = {"MuzzleVelocity","ProjectileSpeed","BulletSpeed","ShellSpeed","MuzzleSpeed","Speed","Velocity"}
    for _, an in ipairs(names) do
        local v = obj:GetAttribute(an)
        if type(v) == "number" and v > 0 then return v end
    end
    return nil
end

function getMuzzleInfo()
    local char = LocalPlayer.Character
    if not char then return nil end

    local tool = char:FindFirstChildOfClass("Tool")
    if tool then
        local pos, dir = findMuzzleFromTool(tool)
        if pos then
            local speed = readSpeedFromAttributes(tool)
            if not speed then
                local h = tool:FindFirstChild("Handle")
                if h then speed = readSpeedFromAttributes(h) end
            end
            return { pos = pos, dir = dir, speed = speed }
        end
    end

    local hum = char:FindFirstChildOfClass("Humanoid")
    if hum and hum.SeatPart and hum.SeatPart:IsA("VehicleSeat") then
        local vehicle = hum.SeatPart:FindFirstAncestorOfClass("Model")
        if vehicle then
            local pos, dir = findMuzzleFromVehicle(vehicle)
            if pos then
                local speed = readSpeedFromAttributes(vehicle)
                return { pos = pos, dir = dir, speed = speed }
            end
        end
    end
    return nil
end

-- ============== RENDER ==============
local RENDER_INTERVAL = 1 / 30
local lastRender = 0

local renderConn = RunService.RenderStepped:Connect(function()
    if state.unloaded then return end
    local now = tick()
    if now - lastRender < RENDER_INTERVAL then return end
    lastRender = now

    local cam = Workspace.CurrentCamera
    if not cam then return end
    local camCF = cam.CFrame
    local camPos = camCF.Position
    local camLook = camCF.LookVector
    local vpSize = cam.ViewportSize

    if state.vEnabled and (now - state.vehicleCacheTime > 1) then
        state.vehicleCacheTime = now
        pcall(refreshVehicleCache)
    end

    if not state.pTeam.enabled then for _, d in pairs(state.teamDrawings) do hideDrawings(d) end end
    if not state.pEnemy.enabled then for _, d in pairs(state.enemyDrawings) do hideDrawings(d) end end
    if not state.vEnabled then for _, d in pairs(state.vehicleDrawings) do hideDrawings(d) end end

    -- PLAYER ESP
    if state.pTeam.enabled or state.pEnemy.enabled then
        for _, player in ipairs(Players:GetPlayers()) do
            if player == LocalPlayer then
                local dt = state.teamDrawings[player] if dt then hideDrawings(dt) end
                local de = state.enemyDrawings[player] if de then hideDrawings(de) end
                continue
            end
            local isEnemy = isEnemyPlayer(player)
            local cfg = isEnemy and state.pEnemy or state.pTeam
            local cache = isEnemy and state.enemyDrawings or state.teamDrawings

            if not cfg.enabled then
                local d = cache[player] if d then hideDrawings(d) end
                continue
            end

            local char = player.Character
            if not char or not Players:FindFirstChild(player.Name) then
                local d = cache[player] if d then hideDrawings(d) end
                continue
            end

            local head = char:FindFirstChild("Head")
            local root = char:FindFirstChild("HumanoidRootPart")
            local hum = char:FindFirstChildOfClass("Humanoid")
            if not head or not root or not hum or hum.Health <= 0 then
                local d = cache[player] if d then hideDrawings(d) end
                continue
            end

            local rootPos = root.Position
            local toT = rootPos - camPos
            if toT:Dot(camLook) < 0 then
                local d = cache[player] if d then hideDrawings(d) end
                continue
            end
            local dist3d = toT.Magnitude
            if dist3d > cfg.maxDist then
                local d = cache[player] if d then hideDrawings(d) end
                continue
            end
            local sp, onScreen = cam:WorldToViewportPoint(rootPos)
            if not onScreen or sp.X < -200 or sp.X > vpSize.X + 200 or sp.Y < -200 or sp.Y > vpSize.Y + 200 then
                local d = cache[player] if d then hideDrawings(d) end
                continue
            end

            local d = safeDraw(cache, player, mkPlayerDrawings)
            if not d then continue end
            local col = col3(cfg.color)

            local headSp = cam:WorldToViewportPoint(head.Position + Vector3.new(0,0.5,0))
            local footSp = cam:WorldToViewportPoint(rootPos - Vector3.new(0,3,0))
            local boxH = math.abs(footSp.Y - headSp.Y)
            local boxW = boxH * 0.55
            local boxX = headSp.X - boxW/2
            local boxY = headSp.Y

            if cfg.showBox and cfg.showOutline then
                setp(d.outline,"Visible",true) setp(d.outline,"Color",Color3.new(0,0,0))
                setp(d.outline,"Thickness",3) setp(d.outline,"Filled",false)
                d.outline.Size=Vector2.new(boxW,boxH) d.outline.Position=Vector2.new(boxX,boxY)
            else setp(d.outline,"Visible",false) end

            if cfg.showBox then
                setp(d.box,"Visible",true) setp(d.box,"Color",col)
                setp(d.box,"Thickness",1) setp(d.box,"Filled",false)
                d.box.Size=Vector2.new(boxW,boxH) d.box.Position=Vector2.new(boxX,boxY)
            else setp(d.box,"Visible",false) end

            if cfg.showName then
                setp(d.name,"Visible",true) setp(d.name,"Text",player.Name)
                setp(d.name,"Color",col) setp(d.name,"Size",13)
                setp(d.name,"Center",true) setp(d.name,"Outline",true)
                setp(d.name,"OutlineColor",Color3.new(0,0,0))
                d.name.Position=Vector2.new(headSp.X,boxY-16)
            else setp(d.name,"Visible",false) end

            if cfg.showDistance then
                setp(d.dist,"Visible",true)
                d.dist.Text=string.format("%.0f studs",dist3d)
                setp(d.dist,"Color",Color3.fromRGB(220,220,220))
                setp(d.dist,"Size",12) setp(d.dist,"Center",true)
                setp(d.dist,"Outline",true) setp(d.dist,"OutlineColor",Color3.new(0,0,0))
                d.dist.Position=Vector2.new(headSp.X,boxY+boxH+3)
            else setp(d.dist,"Visible",false) end

            if cfg.showHealth then
                local hp = math.clamp(hum.Health/hum.MaxHealth,0,1)
                local hpW=boxW local hpH=4 local hpX=boxX local hpY=boxY+boxH+18
                setp(d.hpBg,"Visible",true) setp(d.hpBg,"Filled",true)
                setp(d.hpBg,"Color",Color3.fromRGB(20,20,20))
                d.hpBg.Size=Vector2.new(hpW,hpH) d.hpBg.Position=Vector2.new(hpX,hpY)
                setp(d.hpFill,"Visible",true) setp(d.hpFill,"Filled",true)
                setp(d.hpFill,"Color",hp>0.4 and Color3.fromRGB(60,220,100) or Color3.fromRGB(220,60,60))
                d.hpFill.Size=Vector2.new(hpW*hp,hpH) d.hpFill.Position=Vector2.new(hpX,hpY)
            else
                setp(d.hpBg,"Visible",false) setp(d.hpFill,"Visible",false)
            end
        end
    end

    -- VEHICLE ESP
    if state.vEnabled then
        local myTeam = getMyTeam()
        for vehicle, cache in pairs(state.vehicleCache) do
            if not vehicle or not vehicle.Parent or not cache.pp or not cache.pp.Parent then
                local d = state.vehicleDrawings[vehicle] if d then hideDrawings(d) end
                continue
            end
            local skip = false
            if state.vOnlyEnemy and not cache.isEnemy then skip = true end
            if state.vHideOwn and myTeam and cache.team == myTeam then skip = true end
            if skip then
                local d = state.vehicleDrawings[vehicle] if d then hideDrawings(d) end
                continue
            end
            local pos = cache.pp.Position
            local toV = pos - camPos
            if toV:Dot(camLook) < 0 then
                local d = state.vehicleDrawings[vehicle] if d then hideDrawings(d) end
                continue
            end
            local dist3d = toV.Magnitude
            if dist3d > state.vMaxDistance then
                local d = state.vehicleDrawings[vehicle] if d then hideDrawings(d) end
                continue
            end
            local sp, onScreen = cam:WorldToViewportPoint(pos)
            if not onScreen or sp.X < -400 or sp.X > vpSize.X+400 or sp.Y < -400 or sp.Y > vpSize.Y+400 then
                local d = state.vehicleDrawings[vehicle] if d then hideDrawings(d) end
                continue
            end

            local d = safeDraw(state.vehicleDrawings, vehicle, mkVehDrawings)
            if not d then continue end
            local col = cache.isEnemy and col3(state.vColorEnemy) or col3(state.vColorAlly)

            local cf = cache.pp.CFrame
            local hx,hy,hz = cache.hx, cache.hy, cache.hz
            local cornersWorld = {
                cf*Vector3.new(-hx,-hy,-hz), cf*Vector3.new(hx,-hy,-hz),
                cf*Vector3.new(hx,-hy,hz), cf*Vector3.new(-hx,-hy,hz),
                cf*Vector3.new(-hx,hy,-hz), cf*Vector3.new(hx,hy,-hz),
                cf*Vector3.new(hx,hy,hz), cf*Vector3.new(-hx,hy,hz),
            }
            local pts = {}
            for _, cp in ipairs(cornersWorld) do
                local spc, onc = cam:WorldToViewportPoint(cp)
                if onc then
                    table.insert(pts, {x = spc.X, y = spc.Y})
                end
            end

            local minX, minY, maxX, maxY = math.huge, math.huge, -math.huge, -math.huge
            for _, p in ipairs(pts) do
                if p.x < minX then minX = p.x end
                if p.x > maxX then maxX = p.x end
                if p.y < minY then minY = p.y end
                if p.y > maxY then maxY = p.y end
            end

            if state.vShowOutline and #pts >= 3 then
                local hull = convexHull(pts)
                local nh = #hull
                for i = 1, 12 do
                    local line = d["wire"..i]
                    if line then
                        if i <= nh then
                            local a = hull[i]
                            local b = hull[(i % nh) + 1]
                            line.From = Vector2.new(a.x, a.y)
                            line.To = Vector2.new(b.x, b.y)
                            line.Color = col
                            line.Thickness = 2
                            if not line.Visible then line.Visible = true end
                        else
                            if line.Visible then line.Visible = false end
                        end
                    end
                end
            else
                for i = 1, 12 do
                    local line = d["wire"..i]
                    if line and line.Visible then line.Visible = false end
                end
            end

            if state.vShowName and minX ~= math.huge then
                setp(d.name,"Visible",true) setp(d.name,"Text",vehicle.Name)
                setp(d.name,"Color",col) setp(d.name,"Size",13)
                setp(d.name,"Center",true) setp(d.name,"Outline",true)
                setp(d.name,"OutlineColor",Color3.new(0,0,0))
                d.name.Position=Vector2.new((minX+maxX)/2, minY-16)
            else setp(d.name,"Visible",false) end

            if state.vShowDistance and minX ~= math.huge then
                setp(d.dist,"Visible",true)
                d.dist.Text=string.format("%.0f studs",dist3d)
                setp(d.dist,"Color",Color3.fromRGB(220,220,220))
                setp(d.dist,"Size",12) setp(d.dist,"Center",true)
                setp(d.dist,"Outline",true) setp(d.dist,"OutlineColor",Color3.new(0,0,0))
                d.dist.Position=Vector2.new((minX+maxX)/2, maxY+3)
            else setp(d.dist,"Visible",false) end
        end
    end

    -- TRAJECTORY
    pcall(updateTrajectory, cam, camPos)

    -- DRONE RANGE
    pcall(updateDroneRange, cam)
end)

